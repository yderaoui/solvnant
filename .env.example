# Copy to .env and fill in. Never commit .env.

# --- Browser (public; these end up in the JS bundle) ---------------------------
# Supabase → Project Settings → API. Use the anon / "publishable" key ONLY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Live multiplayer game server (WebSocket). Leave empty locally to use ws://127.0.0.1:8787/ws (npm run game).
# After `npx wrangler deploy`: wss://ai-grand-prix-game.<your-subdomain>.workers.dev/ws
VITE_GAME_URL=

# --- Scheduler only (SECRET; never prefix these with VITE_) ---------------------
SUPABASE_URL=
# Supabase "service_role" / "secret" key. Used by the scheduler to write races.
SUPABASE_SERVICE_ROLE_KEY=
# https://openrouter.ai/keys  (free account; only :free models are used)
OPENROUTER_API_KEY=

# --- Optional tuning --------------------------------------------------------------
# Comma-separated OpenRouter model ids that always get a car (rest are auto-picked free models)
OPENROUTER_MODELS=
MAX_CARS=10
# Models whose code fails sit the race out; house bots top the grid up to this many cars
MIN_CARS=2
# Reuse each model's driver code this long before asking it to write a new one
DRIVER_TTL_HOURS=24
# Max OpenRouter requests per scheduler run (free tier is ~50 requests/day)
DRIVER_REFRESH_PER_RUN=2
# Don't re-ask a model that just failed for this long
RETRY_FAILED_HOURS=6
# Seats per AI League race for player-submitted agents (taken from the model seats)
AGENT_SEATS=3
# How far ahead each scheduler run creates races
RACES_AHEAD_MINUTES=75
# Sent to OpenRouter as HTTP-Referer (your deployed URL)
SITE_URL=
